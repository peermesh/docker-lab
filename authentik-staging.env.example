# ==============================================================
# PeerMesh Core - Authentik Staging Proof Environment Example
# ==============================================================
# Copy to .env.authentik-staging for staging proof only.
# Never commit the copied file or real generated values.
#
# Generate staging-only values locally, for example:
#   openssl rand -base64 36 | tr -d '\n'
#   openssl rand -base64 60 | tr -d '\n'
# ==============================================================

AUTHENTIK_STAGING_HOST=auth
AUTHENTIK_STAGING_PROOF_HOST=auth-proof

# Placeholder examples only. Replace in the untracked copied file.
AUTHENTIK_STAGING_POSTGRES_PASSWORD=replace-with-generated-staging-only-postgres-password
AUTHENTIK_STAGING_SECRET_KEY=replace-with-generated-staging-only-authentik-secret-key
AUTHENTIK_STAGING_BOOTSTRAP_EMAIL=staging-admin@example.invalid
AUTHENTIK_STAGING_BOOTSTRAP_PASSWORD=replace-with-generated-staging-only-bootstrap-password
AUTHENTIK_STAGING_BOOTSTRAP_TOKEN=replace-with-generated-staging-only-bootstrap-token

AUTHENTIK_STAGING_POSTGRES_DB=authentik
AUTHENTIK_STAGING_POSTGRES_USER=authentik
AUTHENTIK_STAGING_ERROR_REPORTING_ENABLED=false
AUTHENTIK_STAGING_DISABLE_UPDATE_CHECK=true

AUTHENTIK_STAGING_WEB_PORT=19080
AUTHENTIK_STAGING_WEBSECURE_PORT=19443
AUTHENTIK_STAGING_MATRIX_FED_PORT=19448
# CORE-SEC-004: Dashboard port no longer published (no --api.insecure).
# AUTHENTIK_STAGING_TRAEFIK_DASHBOARD_PORT — removed
