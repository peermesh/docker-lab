# ==============================================================
# PeerMesh Core - Authentik Production Bootstrap Env Example
# ==============================================================
# Copy this content to the untracked VPS file:
#   ./secrets/authentik_bootstrap.env
#
# Never commit the copied file or real generated values. The production
# compose overlay also mounts the individual Docker secret files:
#   ./secrets/authentik_postgres_password
#   ./secrets/authentik_secret_key
#   ./secrets/authentik_bootstrap_token
# ==============================================================

# Placeholder examples only. Replace these in the untracked VPS secret file.
AUTHENTIK_POSTGRESQL__PASSWORD=replace-with-production-authentik-postgres-password
AUTHENTIK_SECRET_KEY=replace-with-production-authentik-secret-key
AUTHENTIK_BOOTSTRAP_TOKEN=replace-with-production-authentik-bootstrap-token

# Keep this aligned with docker-compose.authentik-production.yml unless the
# owner approves changing the production bootstrap account.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@peers.social
